# Build output
bin/
obj/
*.pdb
*.vshost.*

# Visual Studio / editor state
.vs/
*.suo
*.user
*.userprefs
*~

# Local working copies (not part of the source)
_backup_originali/
bak/

# Game assets: never commit copyrighted Forza data
*.zip
*.carbin
*.xds
*.bix
*.xpr
*.gr2
*.tga
*.slt
*.str
*.rdf
*.org
*.bin
*.xml
*.xma
*.xwb
*.xsb
*.wav
\!FH demo car*/
\!FM4 demo car*/

# Test material: textures, models and exports used for trials
*.bmp
*.png
*.jpg
*.jpeg
*.gif
*.tif
*.tiff
*.dds
*.psd
*.obj
*.mtl
*.fbx
*.dae
*.3ds
*.z3d
*.blend
*.blend1
*.csv
*.txt
*.log
*.bak
*.orig
test/
tests/
prove/
scratch/
temp/
tmp/

# Documentation is part of the source
!/docs/*.txt

# App images and icons are part of the source
!/Resources/*.png
!/Resources/*.gif

# Third-party tools: only MIT-licensed ones are committed (see THIRD-PARTY-NOTICES.md).
# Xbox 360 SDK files (xcompress) and xds.dll stay local.
/\!ForzaStudio release/*
!/\!ForzaStudio release/Be.Windows.Forms.HexBox.dll
!/\!ForzaStudio release/texconv.exe

# Runtime files written next to the exe
settings.txt
materials.txt

# tools/Fm4Cars: built tool and the copies of the program it needs (not redistributable binaries)
tools/Fm4Cars/*.exe
tools/Fm4Cars/*.dll
tools/Fm4Cars/*.ini

# Release zips
dist/
