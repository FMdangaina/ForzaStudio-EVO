  <!-- Prerequisites: stop with a clear message instead of dozens of compiler errors -->
  <Target Name="CheckPrerequisites" BeforeTargets="BeforeBuild">
    <Error Condition="!Exists('$(windir)\assembly\GAC_32\Microsoft.Xna.Framework\3.1.0.0__6d5c3888ef60e27d\Microsoft.Xna.Framework.dll')"
           Text="XNA Game Studio 3.1 (Microsoft.Xna.Framework 3.1) is not installed. Install the XNA 3.1 Redistributable (or XNA Game Studio 3.1), then build again. See README.md, section Build." />
    <Warning Condition="!Exists('!ForzaStudio release\xds.dll')"
             Text="!ForzaStudio release\xds.dll is missing: the program builds but does not run. Put the local files listed in README.md in that folder." />
  </Target>
  <!-- Runtime files (xds.dll, xcompress.dll, bundler...) live in '!ForzaStudio release': copy them next to the exe -->
  <Target Name="CopyRuntimeFiles" AfterTargets="Build">
    <ItemGroup>
      <RuntimeFile Include="!ForzaStudio release\*.*" />
    </ItemGroup>
    <Copy SourceFiles="@(RuntimeFile)" DestinationFolder="$(OutDir)" SkipUnchangedFiles="true" ContinueOnError="true" />
  </Target>
  <!-- x86 exe: set IMAGE_FILE_LARGE_ADDRESS_AWARE (0x20 in the PE Characteristics) so a 64-bit Windows gives it 4 GB instead of 2 GB -->
  <Target Name="AfterBuild">
    <Exec ContinueOnError="true" Command="powershell -NoProfile -ExecutionPolicy Bypass -Command &quot;$p='$(TargetPath)'; $b=[IO.File]::ReadAllBytes($p); $o=[BitConverter]::ToInt32($b,60)+22; if(($b[$o] -band 0x20) -eq 0){ $b[$o]=$b[$o] -bor 0x20; [IO.File]::WriteAllBytes($p,$b) }&quot;" />
  </Target>
