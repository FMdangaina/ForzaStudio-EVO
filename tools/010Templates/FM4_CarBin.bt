//------------------------------------------------
// ForzaStudio EVO (https://github.com/FMdangaina/ForzaStudio-EVO), GPL-3.0.
// Written for ForzaStudio EVO on the object tree and names of FH2_CarBin.bt by Draff (Discord),
// included with the author's permission. Format notes: docs/CARBIN_ALL_GAMES.md.

//------------------------------------------------
// 010 Editor Binary Template: Forza Motorsport 4 (Xbox 360) .carbin
//
// Built on FH2_CarBin.bt (same object tree, same names, same order), so an FM4 file and
// an FH1/FH2 file of the same car show the same tree side by side. Versions are those of
// FM4; the version gates of the FH2 template are kept, so the code paths are identical.
//
//                     FM4        (FH1/FH2)
//   BodyHeader          2         5      (no light flares in FM4; WheelLighting: only
//                                         coefficients 0-3 are set, FM4 leaves 4-15 uninitialised, FH writes 0)
//   TireHeader          3         3
//   BrakeHeader         1         1
//   ModelSettings      16        17      (same layout: 15 gauges, BoneCount, BoneTable)
//   ShaderVersion      16        16
//   PartPhysics         5         5      (5 = BoneWeightCount + DamageMorphs)
//   MeshMaterial        3         3
//   VertexBuffer        2         3      (FM4: no BufferFlags / SharingKey)
//   IndexBuffer         3         4      (FM4: no BufferFlags / SharingKey)
//   vertex stride      32        28      (FM4 adds SH0 = 4 x SNORM16 baked ambient)
//   damage word         4         4      same 11:11:10 bits, DIFFERENT meaning (below)
//
// Added decoding (shown in the Value column, nothing changes in the file):
//   Vertex     -> position in metres (car space), normal, raw UV / 65535
//   DamageMorph-> FM4 direction + weight, and the vertex it belongs to (index + position)
//   Part       -> name, deformable flag, counts
//   Mesh       -> material, LOD, index count
// The Output panel gets one line per part with damage word statistics.
//
// Position:  pos = OffsetFromCarOrigin + (BoundsMin + BoundsMax) / 2
//                + (X, Y, Z) / 32767 * PositionScale / 32767 * S,   S = |BoundsMax - centre|
// Normal:    TangentFrame = quaternion (x, y, z, w) SNORM16; normal = X axis of its matrix.
// Damage:    11:11:10 signed, X in the LOW bits. FM4 = unit direction (x/1023, y/1023, z/511),
//            length 0..1 = weight, 000003FF = (1, 0, 0) = no damage. FH stores the crushed
//            offset in metres instead (x/1023*2 ...): see FH2_CarBin.bt.
//            One word per vertex: DamageMorph[i] <-> Vertices[i], DamageMorphLOD0[i] <-> VerticesLOD0[i].
//------------------------------------------------
BigEndian();
BitfieldRightToLeft();

typedef struct {
    float X;
    float Y;
    float Z;
} Vec3 <read=Vec3Read>;

string Vec3Read(Vec3 &v) {
    return Str("(%g, %g, %g)", v.X, v.Y, v.Z);
}

typedef struct {
    float X;
    float Y;
    float Z;
    float W;
} Vec4 <read=Vec4Read>;

string Vec4Read(Vec4 &v) {
    return Str("(%g, %g, %g, %g)", v.X, v.Y, v.Z, v.W);
}

typedef struct {
    Vec4 Row[4];
} Matrix4x4;

typedef struct {
    uint32 Length;
    if (Length > 0)
        char Text[Length];
} LString <read=LStringRead>;

string LStringRead(LString &s) {
    if (s.Length > 0)
        return s.Text;
    return "";
}

typedef struct {
    uint32 KeyValid     : 1;
    uint32 DataStripped : 1;
    uint32 Reserved     : 30;
} BufferFlags;

typedef enum <ubyte> {
    BULB_STANDARD = 0,
    BULB_HALOGEN  = 1,
    BULB_XENON    = 2,
    BULB_OLD      = 3,
    BULB_DIFFUSE  = 4
} LightBulbType;

typedef struct {
    ubyte Left     : 1;
    ubyte Right    : 1;
    ubyte Front    : 1;
    ubyte Rear     : 1;
    ubyte Reserved : 3;
    ubyte ForceOn  : 1;
} LightLocation;

typedef struct {
    ubyte Headlight : 1;
    ubyte Taillight : 1;
    ubyte Brake     : 1;
    ubyte Indicator : 1;
    ubyte Reverse   : 1;
    ubyte Reserved  : 3;
} LightFunction;

typedef enum <uint32> {
    EMITTER_ENGINE_SMOKE = 0
} EmitterType;

typedef enum <int32> {
    PRIMITIVE_POINT_LIST     = 1,
    PRIMITIVE_LINE_LIST      = 2,
    PRIMITIVE_LINE_STRIP     = 3,
    PRIMITIVE_TRIANGLE_LIST  = 4,
    PRIMITIVE_TRIANGLE_FAN   = 5,
    PRIMITIVE_TRIANGLE_STRIP = 6,
    PRIMITIVE_RECT_LIST      = 8,
    PRIMITIVE_QUAD_LIST      = 13
} PrimitiveType;

typedef struct {
    Vec4 Center;
    Vec4 Axis[3];
    Vec4 HalfExtents;
} OrientedBox;

typedef struct {
    float Coefficients[16];
} SphericalHarmonics;

//------------------------------------------------
// Lookup tables filled while parsing, used by the read functions.
//------------------------------------------------
local int    MAXB = 2048;
local int    gParts = 0;            // parts seen so far (index of the current part = gParts - 1)
local float  gOffX[2048], gOffY[2048], gOffZ[2048];  // part origin + bounds centre
local float  gS[2048];              // |bounds half-extent|
local int    gBufs = 0;             // registered buffers
local int64  gBufStart[2048];       // first data byte
local int    gBufCount[2048];
local int    gBufStride[2048];
local int    gBufPart[2048];
local int    gBufRole[2048];        // 0 Vertices, 1 VerticesLOD0, 2 DamageMorph, 3 DamageMorphLOD0
local int    gBad = 0;              // version mismatches against FM4

void ExpectVersion(string what, uint32 found, uint32 fm4) {
    if (found != fm4) {
        gBad++;
        Printf("WARNING: %s version %u (FM4 uses %u) at 0x%X\n", what, found, fm4, FTell() - 4);
    }
}

void RegisterBuffer(int64 start, int count, int stride, int role) {
    if (gBufs < MAXB && count > 0) {
        gBufStart[gBufs]  = start;
        gBufCount[gBufs]  = count;
        gBufStride[gBufs] = stride;
        gBufPart[gBufs]   = gParts - 1;
        gBufRole[gBufs]   = role;
        gBufs++;
    }
}

int FindBuffer(int64 pos) {
    local int b;
    for (b = gBufs - 1; b >= 0; b--)
        if (pos >= gBufStart[b] && pos < gBufStart[b] + (int64)gBufCount[b] * gBufStride[b])
            return b;
    return -1;
}

int FindPartBuffer(int part, int role) {
    local int b;
    for (b = 0; b < gBufs; b++)
        if (gBufPart[b] == part && gBufRole[b] == role)
            return b;
    return -1;
}

float SN(int16 v) {
    return v / 32767.0;
}

// FM4 vertex position in metres at 'pos' (start of a stride-32 vertex) of part 'part'.
string PositionAt(int64 pos, int part) {
    local float x = SN(ReadShort(pos));
    local float y = SN(ReadShort(pos + 2));
    local float z = SN(ReadShort(pos + 4));
    local float r = SN(ReadShort(pos + 6)) * gS[part];
    return Str("(%.4f, %.4f, %.4f)", gOffX[part] + x * r, gOffY[part] + y * r, gOffZ[part] + z * r);
}

string NormalAt(int64 pos) {
    local float qx = SN(ReadShort(pos + 16));
    local float qy = SN(ReadShort(pos + 18));
    local float qz = SN(ReadShort(pos + 20));
    local float qw = SN(ReadShort(pos + 22));
    return Str("(%.3f, %.3f, %.3f)",
        1.0 - 2.0 * (qy * qy + qz * qz),
        2.0 * (qx * qy + qz * qw),
        2.0 * (qx * qz - qy * qw));
}

typedef struct (uint32 version) {
    Vec3          Position;
    int16         Direction[3];
    ubyte         Index;
    LightBulbType BulbType;
    LightLocation Location;
    LightFunction Function;
    ubyte         ColourR;
    ubyte         ColourG;
    ubyte         ColourB;
    ubyte         Size;
    ubyte         TextureIndex;
    if (version >= 4)
        byte      DamagePosition[3];
    if (version >= 5) {
        ubyte     StartFadeAngle;
        ubyte     EndFadeAngle;
    }
} LightFlare <bgcolor=cLtYellow>;

typedef struct {
    uint32 Version;
    ExpectVersion("BodyHeader", Version, 2);
    SphericalHarmonics WheelLighting[4];
    if (Version > 1)
        OrientedBox RearViewMirrorBox;
    if (Version >= 3) {
        uint32 LightFlareCount;
        local int i;
        for (i = 0; i < LightFlareCount; i++)
            LightFlare Flare(Version);
    }
} BodyHeader <bgcolor=cLtGray>;

typedef struct {
    float LipMinX[2];
    float LipMaxX[2];
    float TireMinX[2];
    float TireMaxX[2];
    float RimMaxRadius[2];
    float TireMaxRadius[2];
} TireExtents;

typedef struct {
    uint32 Version;
    ExpectVersion("TireHeader", Version, 3);
    if (Version >= 2) {
        int32 HasBrakePivot;
        Vec4  BrakePivot;
    }
    if (Version >= 3)
        TireExtents Extents;
} TireHeader <bgcolor=cLtGray>;

typedef struct {
    uint32 Version;
    ExpectVersion("BrakeHeader", Version, 1);
} BrakeHeader <bgcolor=cLtGray>;

typedef struct {
    uint32      Version;
    EmitterType Type;
    if (Version >= 2)
        int32   ParentPartIndex;
    Matrix4x4   BackfireTransform;
    if (Version >= 2)
        Matrix4x4 EngineSmokeTransform;
} Emitter <bgcolor=cLtRed>;

typedef struct {
    uint32 ListVersion;
    uint32 Count;
    local int i;
    for (i = 0; i < Count; i++)
        Emitter Item;
} EmitterList;

typedef struct {
    uint32 Version;
    if (Version == 3) {
        Vec4 SteeringWheelPosition;
        Vec4 SteeringWheelAxis;
        Vec4 LeftHandAnchor;
        Vec4 RightHandAnchor;
        Vec4 SeatAnchor;
        Vec4 ShifterAnchor;
        Vec4 RightHandOuterLOD0;
        Vec4 LeftHandOuterLOD0;
        Vec4 RightHandInnerLOD0;
        Vec4 LeftHandInnerLOD0;
        Vec4 RightHandCenterLOD0;
        Vec4 LeftHandCenterLOD0;
        Vec4 SteeringWheelPositionLOD0;
        Vec4 SteeringWheelAxisLOD0;
        Vec4 SeatAnchorLOD0;
        Vec4 ShifterAnchorLOD0;
    } else if (Version == 2) {
        Vec4 Anchor[13];
    } else {
        Vec4 Anchor[6];
    }
} DriverAnchors <bgcolor=cLtPurple>;

typedef struct {
    Vec4  Pivot;
    Vec4  Axis;
    float MaxRotation;
} Gauge <bgcolor=cLtAqua>;

typedef struct (uint32 count) {
    if (count > 0)  Gauge Speedometer;
    if (count > 1)  Gauge Tachometer;
    if (count > 2)  Gauge Fuel;
    if (count > 3)  Gauge Boost;
    if (count > 4)  Gauge OilTemperature;
    if (count > 5)  Gauge OilPressure;
    if (count > 6)  Gauge WaterTemperature;
    if (count > 7)  Gauge Voltage;
    if (count > 8)  Gauge AuxiliaryA;
    if (count > 9)  Gauge AuxiliaryB;
    if (count > 10) Gauge AuxiliaryC;
    if (count > 11) Gauge AuxiliaryD;
    if (count > 12) Gauge AuxiliaryE;
    if (count > 13) Gauge AuxiliaryF;
    if (count > 14) Gauge Power;
} GaugeSet;

typedef struct {
    uint32 ListVersion;
    uint32 Count;
    local int i;
    for (i = 0; i < Count; i++)
        LString BoneName;
} BoneTable <bgcolor=cLtGreen>;

typedef struct {
    uint32        Version;
    ExpectVersion("ModelSettings", Version, 16);
    uint32        ShaderVersion;
    EmitterList   Emitters;
    DriverAnchors Driver;
    int32         StartLOD;
    int32         EndLOD;
    local uint32 gaugeCount = 3;
    if (Version >= 16)
        gaugeCount = 15;
    else if (Version >= 13)
        gaugeCount = 4;
    GaugeSet      Gauges(gaugeCount);
    float         LightingOffset;
    float         LightingScale;
    if (Version >= 14)
        int32     BoneCount;
    if (Version >= 15)
        BoneTable Bones;
} ModelSettings <bgcolor=cSilver>;

// Entry of a draw list: part index + mesh index inside that part.
typedef struct {
    uint16 PartIndex;
    uint16 MaterialIndex;
} DrawEntry <read=DrawEntryRead>;

string DrawEntryRead(DrawEntry &e) {
    return Str("part %u, mesh %u", e.PartIndex, e.MaterialIndex);
}

typedef struct {
    int32 Count;
    if (Count > 0)
        DrawEntry Entry[Count];
} DrawList;

typedef struct {
    uint32 Version;
    int32  LODCount;
    local int i;
    for (i = 0; i < LODCount; i++)
        DrawList TransparentLOD;
    for (i = 0; i < LODCount; i++)
        DrawList OpaqueLOD;
} DrawOrder <bgcolor=cLtPurple>;

typedef struct {
    uint32 Version;
    uint32 VertexListVersion;
    uint32 VertexCount;
    if (VertexCount > 0)
        Vec4 Vertex[VertexCount];
    uint32 IndexListVersion;
    uint32 IndexCount;
    if (IndexCount > 0)
        uint16 Index[IndexCount];
} GlassShards;

typedef struct {
    uint32      Version;
    ExpectVersion("PartPhysics", Version, 5);
    Vec3        OffsetFromCarOrigin;
    Vec3        BoundsMin;
    Vec3        BoundsMax;
    float       Mass;
    Vec3        CenterOfMass;
    float       DetachDamage;
    GlassShards GlassBreakup;
    ubyte       HasTransparentMeshes;
    if (Version >= 4)
        int32   BoneWeightCount;
} PartPhysics <bgcolor=cLtRed>;

// FM4 vertex, stride 32. See the header for the decoding.
typedef struct {
    int16  PositionX;
    int16  PositionY;
    int16  PositionZ;
    int16  PositionScale;
    uint16 U0;
    uint16 V0;
    uint16 U1;
    uint16 V1;
    int16  TangentFrame[4];   // quaternion x, y, z, w (SNORM16); normal = its X axis
    int16  SH0[4];            // baked ambient: level + direction (SNORM16)
} Vertex <read=VertexRead, bgcolor=cLtGreen>;

string VertexRead(Vertex &v) {
    local int64 pos = startof(v);
    local int b = FindBuffer(pos);
    if (b < 0)
        return "";
    return Str("#%d pos %s m  n %s  uv (%.4f, %.4f)",
        (int)((pos - gBufStart[b]) / gBufStride[b]),
        PositionAt(pos, gBufPart[b]), NormalAt(pos),
        ReadUShort(pos + 8) / 65535.0, ReadUShort(pos + 10) / 65535.0);
}

// FM4 damage word: unit direction + weight. 000003FF = none.
typedef struct {
    int32 X : 11;
    int32 Y : 11;
    int32 Z : 10;
} DamageOffset <read=DamageOffsetRead, bgcolor=0xC0A0FF>;

string DamageOffsetRead(DamageOffset &d) {
    local int64 pos = startof(d);
    local uint32 raw = ReadUInt(pos);
    local string vert = "";
    local int b = FindBuffer(pos);
    if (b >= 0) {
        local int idx = (int)((pos - gBufStart[b]) / 4);
        local int vb = FindPartBuffer(gBufPart[b], gBufRole[b] - 2);
        if (vb >= 0 && idx < gBufCount[vb] && gBufStride[vb] == 32)
            vert = Str("  <- vertex #%d %s m", idx, PositionAt(gBufStart[vb] + (int64)idx * 32, gBufPart[b]));
        else
            vert = Str("  <- vertex #%d", idx);
    }
    if (raw == 0x3FF)
        return "none (3FF)" + vert;
    local float x = d.X / 1023.0;
    local float y = d.Y / 1023.0;
    local float z = d.Z / 511.0;
    return Str("dir (%.3f, %.3f, %.3f) w %.3f", x, y, z, Sqrt(x * x + y * y + z * z)) + vert;
}

// Wheels: LOD0 morph target (rim at max size) + the vertex itself, 8 half floats.
typedef struct {
    hfloat Y;
    hfloat X;
    hfloat W;
    hfloat Z;
} WheelMorphPosition <read=WheelMorphPositionRead>;

string WheelMorphPositionRead(WheelMorphPosition &p) {
    return Str("(%g, %g, %g)", p.X * p.W, p.Y * p.W, p.Z * p.W);
}

typedef struct {
    WheelMorphPosition Target0;   // LOD0 morph target
    WheelMorphPosition Target1;   // the vertex itself
} WheelMorphVertex <bgcolor=0xC0A0FF>;

// role: 0 Vertices, 1 VerticesLOD0, 2 DamageMorph, 3 DamageMorphLOD0
typedef struct (int role) {
    uint32 Version;
    ExpectVersion("VertexBuffer", Version, 2);
    int32  Count;
    int32  Stride;
    local int isMorph = role >= 2;
    local uint32 flags = 0;
    if (Version >= 3) {
        BufferFlags Flags;
        flags = ReadUInt(startof(Flags));
    }
    if (flags & 1)
        uint32 SharingKey;
    if (Count > 0 && !(flags & 2)) {
        RegisterBuffer(FTell(), Count, Stride, role);
        if (!isMorph && Stride == 32)
            Vertex Vertices[Count];
        else if (isMorph && Stride == 4)
            DamageOffset DamageOffsets[Count];
        else if (isMorph && Stride == 16)
            WheelMorphVertex WheelMorphs[Count];
        else
            ubyte Data[Count * Stride];
    }
} VertexBuffer <read=VertexBufferRead, bgcolor=cLtBlue>;

string VertexBufferRead(VertexBuffer &b) {
    if (b.Count == 0)
        return "empty";
    return Str("%d x %d bytes", b.Count, b.Stride);
}

typedef struct {
    float OffsetU;
    float ScaleU;
    float OffsetV;
    float ScaleV;
} UVTransform;

typedef struct {
    uint32 Version;
    if (Version >= 2)
        ubyte RemoveFromShadow;
    if (Version >= 3) {
        UVTransform UV0Transform;
        UVTransform UV1Transform;
        UVTransform UV2Transform;
        UVTransform UV3Transform;
    }
} MeshMaterialSettings <bgcolor=cLtAqua>;

typedef struct {
    uint32 Version;
    Vec4   PositionOffset;
    Vec4   PositionScale;
    Vec4   UVOffsetScale;
} Unpacking <bgcolor=cLtAqua>;

typedef struct {
    uint32 Version;
    ExpectVersion("IndexBuffer", Version, 3);
    local uint32 flags = 0;
    if (Version >= 4) {
        BufferFlags Flags;
        flags = ReadUInt(startof(Flags));
    }
    if (flags & 1)
        uint32 SharingKey;
    int32 Count;
    int32 IndexSize;
    if (Count > 0 && !(flags & 2)) {
        if (IndexSize == 4)
            uint32 Indices[Count] <bgcolor=cSilver>;   // strips, restart 0x00FFFFFF
        else
            uint16 Indices[Count] <bgcolor=cSilver>;   // strips, restart 0xFFFF
    }
} IndexBuffer <bgcolor=cLtBlue>;

typedef struct {
    MeshMaterialSettings MaterialSettings;
    uint32        Version;
    LString       MaterialName;
    int32         LOD;
    PrimitiveType Primitive;
    int32         MaterialIndex;
    Unpacking     PositionUnpacking;
    IndexBuffer   Indices;
    if (Version >= 2)
        uint32    MeshFlags;
} Mesh <read=MeshRead, bgcolor=cLtAqua>;

string MeshRead(Mesh &m) {
    return Str("LOD %d  %s  (%d indices)", m.LOD, LStringRead(m.MaterialName), m.Indices.Count);
}

typedef struct {
    uint32 ListVersion;
    uint32 Count;
    local int i;
    for (i = 0; i < Count; i++)
        Mesh Item;
} MeshList;

typedef struct {
    uint32       Version;
    ubyte        HasDamageMorphs;   // 1 = deformable part
    VertexBuffer DamageMorph(2);
    VertexBuffer DamageMorphLOD0(3);
} DamageMorphs <bgcolor=0xC0A0FF>;

// Output panel line: damage word statistics of one buffer.
void DamageStats(string name, int part, int role) {
    local int b = FindPartBuffer(part, role);
    if (b < 0 || gBufStride[b] != 4)
        return;
    local int i, none = 0, zero = 0, unit = 0;
    local int32 w, x, y, z;
    local float fx, fy, fz, len, sum = 0;
    for (i = 0; i < gBufCount[b]; i++) {
        w = ReadInt(gBufStart[b] + (int64)i * 4);
        if (w == 0x3FF) { none++; continue; }
        if (w == 0) { zero++; continue; }
        x = (w << 21) >> 21;
        y = (w << 10) >> 21;
        z = w >> 22;
        fx = x / 1023.0; fy = y / 1023.0; fz = z / 511.0;
        len = Sqrt(fx * fx + fy * fy + fz * fz);
        sum += len;
        if (len > 0.9)
            unit++;
    }
    local int n = gBufCount[b] - none - zero;
    Printf("    %-16s %6d words  none(3FF) %5.1f%%  zero %5.1f%%  mean weight %.3f  >0.9 %5.1f%%\n",
        name, gBufCount[b], 100.0 * none / gBufCount[b], 100.0 * zero / gBufCount[b],
        n > 0 ? sum / n : 0.0, n > 0 ? 100.0 * unit / n : 0.0);
}

typedef struct {
    PartPhysics  Physics;
    // lookup data for the read functions
    gOffX[gParts] = Physics.OffsetFromCarOrigin.X + (Physics.BoundsMin.X + Physics.BoundsMax.X) / 2;
    gOffY[gParts] = Physics.OffsetFromCarOrigin.Y + (Physics.BoundsMin.Y + Physics.BoundsMax.Y) / 2;
    gOffZ[gParts] = Physics.OffsetFromCarOrigin.Z + (Physics.BoundsMin.Z + Physics.BoundsMax.Z) / 2;
    local float hx = (Physics.BoundsMax.X - Physics.BoundsMin.X) / 2;
    local float hy = (Physics.BoundsMax.Y - Physics.BoundsMin.Y) / 2;
    local float hz = (Physics.BoundsMax.Z - Physics.BoundsMin.Z) / 2;
    gS[gParts] = Sqrt(hx * hx + hy * hy + hz * hz);
    gParts++;
    uint32       Version;
    LString      Name <bgcolor=cYellow>;
    VertexBuffer Vertices(0);
    MeshList     Meshes;
    if (Physics.Version > 1)
        VertexBuffer VerticesLOD0(1);
    if (Physics.Version >= 5)
        DamageMorphs Damage;
    Printf("#%-3d %-20s verts %6d  lod0 %6d  meshes %3d  %s\n", gParts - 1, LStringRead(Name),
        Vertices.Count, Physics.Version > 1 ? VerticesLOD0.Count : 0, Meshes.Count,
        (Physics.Version >= 5 && Damage.HasDamageMorphs) ? "DEFORMABLE" : "rigid");
    DamageStats("DamageMorph", gParts - 1, 2);
    DamageStats("DamageMorphLOD0", gParts - 1, 3);
} Part <read=PartRead, bgcolor=cNone>;

string PartRead(Part &p) {
    local string s = LStringRead(p.Name);
    if (p.Physics.Version >= 5 && p.Damage.HasDamageMorphs)
        s += "  [deformable]";
    return s + Str("  %d verts", p.Vertices.Count);
}

typedef struct {
    uint32 ListVersion;
    uint32 Count;
    local int i;
    for (i = 0; i < Count; i++)
        Part Item;
} PartList;

typedef struct {
    uint32 ListVersion;
    uint32 Count;
    if (Count > 0)
        Vec4 Item[Count];
} Vec4List;

typedef struct {
    uint32 ListVersion;
    uint32 Count;
    if (Count > 0)
        int32 Item[Count];
} IntList;

typedef struct {
    uint32   Version;
    int32    ShaderFileIndex;
    int32    TechniqueIndex;
    Vec4List VertexShaderConstants;
    Vec4List PixelShaderConstants;
    IntList  TextureIndices;
} Material <bgcolor=cLtYellow>;

typedef struct {
    uint32 Version;
    uint32 ListVersion;
    uint32 Count;
    local int i;
    for (i = 0; i < Count; i++)
        Material Item;
} MaterialSet;

typedef struct {
    uint32 ListVersion;
    uint32 Count;
    local int i;
    for (i = 0; i < Count; i++)
        MaterialSet Item;
} MaterialSetList;

typedef struct {
    uint32 ListVersion;
    uint32 Count;
    local int i;
    for (i = 0; i < Count; i++)
        LString Item;
} StringList <bgcolor=cLtGray>;

typedef struct {
    uint32          Version;
    DrawOrder       Draws;
    PartList        Parts;
    MaterialSetList MaterialSets;
    StringList      ShaderFileNames;
    StringList      MeshNames;
} Model;

//------------------------------------------------
// File kind: tire (first word 3, ModelSettings at 72), brake (1, at 4), else body.
//------------------------------------------------
local uint32 first = ReadUInt(0);
local uint32 kind = 0;
if (FileSize() >= 76 && first == 3 && ReadUInt(72) >= 9 && ReadUInt(72) <= 17)
    kind = 1;
else if (FileSize() >= 28 && first == 2 && ReadUInt(24) >= 9 && ReadUInt(24) <= 17)
    kind = 1;
else if (FileSize() >= 8 && first == 1 && ReadUInt(4) >= 9 && ReadUInt(4) <= 17)
    kind = 2;

Printf("FM4_CarBin.bt: %s\n", kind == 1 ? "tire / wheel" : kind == 2 ? "brake" : "body");

if (kind == 1)
    TireHeader Header;
else if (kind == 2)
    BrakeHeader Header;
else
    BodyHeader Header;

ModelSettings Settings;
Model         Geometry;

if (!FEof()) {
    Printf("WARNING: %d bytes after the model\n", FileSize() - FTell());
    ubyte Trailing[FileSize() - FTell()];
}
if (gBad > 0)
    Printf("%d version values differ from FM4: this is probably not an FM4 file (FH: FH2_CarBin.bt)\n", gBad);
else
    Printf("OK: parsed to the last byte, all versions = FM4\n");
